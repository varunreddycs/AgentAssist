<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AgentAssist</RootNamespace>
    <!-- Must match codeConfiguration.entryPoint in azure.yaml: agent-assist.dll -->
    <AssemblyName>agent-assist</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- OPENAI001 / MEAI001: preview APIs used by the Foundry hosting packages. -->
    <NoWarn>$(NoWarn);NU1903;NU1605;OPENAI001;MEAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Hosted-agent runtime (AgentHost, AddFoundryResponses / MapFoundryResponses). Brings
      Microsoft.Agents.AI (AgentSkillsProvider), Microsoft.Agents.AI.Foundry (AIProjectClient.AsAIAgent),
      Azure.AI.Projects and Azure.Identity transitively at the versions this release was built
      against. Do not pin those separately; bump this version instead.
    -->
    <PackageReference Include="Microsoft.Agents.AI.Foundry.Hosting" Version="1.27.0-preview.261030.1" />

    <!-- Local runs only: loads .env when present. The hosted runtime has no .env. -->
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Agent Skills are read from <app>/skills at startup. **\* (not **\*.md) so the scripts/*.py
      files ship too; without them run_skill_script has nothing to run. The Remove first: the Web
      SDK already includes **\*.json as Content, so a references/*.json resource would otherwise be
      a duplicate Content item (NETSDK1022).
    -->
    <Content Remove="skills\**" />
    <Content Include="skills\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
