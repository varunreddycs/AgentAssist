# Local runs only: copy to .env. The hosted runtime injects FOUNDRY_PROJECT_ENDPOINT itself. Never commit .env.
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4-mini
# Local only: keep DefaultAzureCredential on developer credentials (az login) and skip the managed-identity probe.
AZURE_TOKEN_CREDENTIALS=dev
# Optional overrides
# AGENT_SKILLS_PATH=
# AGENT_SKILLS_PYTHON=python
# AGENT_SKILLS_SCRIPT_TIMEOUT_SECONDS=30
# Foundry toolbox(es) that serve the MAPS data tools, comma-separated; unset means skills only.
# TOOLBOX_NAME=maps-tools
